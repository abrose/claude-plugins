#!/usr/bin/env bash
# Start a team agent in a Herdr pane and record it under $TEAM_SCRATCH/.team.
# Exit codes: 0 ok, 2 bad arguments, 3 pre-flight failed, 4 herdr error.
set -euo pipefail

usage() {
  echo "usage: team-start <name> <role> (--pane <id> | --split <pane> right|down | --into-tab <tab_id>)" >&2
  echo "       [--effort low|medium|high] [--mode auto|accept-edits] [--cwd <dir>] [--dry-run]" >&2
  exit 2
}

json_get() { python3 -c "import sys,json;d=json.load(sys.stdin);print($1)"; }

[ $# -ge 2 ] || usage
name="$1"; role="$2"; shift 2
[[ "$name" =~ ^[a-z][a-z0-9_-]{0,31}$ ]] || { echo "bad name: $name" >&2; exit 2; }

case "$role" in
  investigator) def_effort=medium; model=claude-opus-4-8; bar_model=Opus ;;
  implementer)  def_effort=medium; model=claude-sonnet-5; bar_model=Sonnet ;;
  tester)       def_effort=low;    model=claude-sonnet-5; bar_model=Sonnet ;;
  *) echo "unknown role: $role" >&2; exit 2 ;;
esac

pane=""; split_pane=""; split_dir=""; into_tab=""; effort=""; mode=auto; cwd="$PWD"; dry_run=""; spilled_tab=""
while [ $# -gt 0 ]; do
  case "$1" in
    --pane)     pane="${2:?}"; shift 2 ;;
    --split)    split_pane="${2:?}"; split_dir="${3:?}"; shift 3 ;;
    --into-tab) into_tab="${2:?}"; shift 2 ;;
    --effort)   effort="${2:?}"; shift 2 ;;
    --mode)     mode="${2:?}"; shift 2 ;;
    --cwd)      cwd="${2:?}"; shift 2 ;;
    --dry-run)  dry_run=1; shift ;;
    *) echo "unknown argument: $1" >&2; usage ;;
  esac
done

effort="${effort:-$def_effort}"
[ -n "$pane" ] || [ -n "$split_pane" ] || [ -n "$into_tab" ] || usage
if [ -n "$into_tab" ] && { [ -n "$pane" ] || [ -n "$split_pane" ]; }; then
  echo "--into-tab is mutually exclusive with --pane/--split" >&2
  exit 2
fi
case "$split_dir" in ""|right|down) ;; *) echo "bad --split direction: $split_dir" >&2; exit 2 ;; esac

label="$name"
teamcfg="${TEAM_SCRATCH:-scratchpad}/.team/config.json"
if [ -f "$teamcfg" ]; then
  team_id="$(python3 -c "import sys,json;print(json.load(sys.stdin).get('team_id',''))" <"$teamcfg" 2>/dev/null || true)"
  if [ -n "${team_id:-}" ]; then
    # Prepend the team id, but tolerate a name that already carries it: the
    # orchestrator refers to agents by their full <team_id>-<label> name, so it
    # may pass that back here. Prepending again would double the id.
    case "$label" in
      "${team_id}-"*) name="$label" ;;
      *) name="${team_id}-${label}" ;;
    esac
    [[ "$name" =~ ^[a-z][a-z0-9_-]{0,31}$ ]] || { echo "namespaced name too long: $name" >&2; exit 2; }
  fi
fi

if [ -n "$dry_run" ]; then
  echo "herdr agent start $name --kind claude --pane <pane> --timeout 90000 -- --agent team-$role --effort $effort --permission-mode $mode"
  exit 0
fi

# Refuse a name a live agent already holds: starting it would seize that agent's
# pane and cross-poison it. A dead agent (absent from the list) is fine to reuse.
if herdr agent list 2>/dev/null | NAME="$name" python3 -c "import sys, os, json
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(1)
sys.exit(0 if any(a.get('name') == os.environ['NAME'] for a in d.get('result', {}).get('agents', [])) else 1)"; then
  echo "name already in use by a live agent: $name" >&2
  exit 3
fi

if [ -n "$into_tab" ]; then
  count="$(herdr pane list | python3 -c "import sys,json;t='$into_tab';print(sum(1 for p in json.load(sys.stdin)['result']['panes'] if p.get('tab_id')==t))")"
  if [ "$count" -ge 6 ]; then
    out=$(herdr tab create --workspace "${HERDR_WORKSPACE_ID:?}" --cwd "$cwd" --no-focus) || exit 4
    spilled_tab=$(echo "$out" | json_get "d['result']['tab']['tab_id']")
    pane=$(echo "$out" | json_get "d['result']['root_pane']['pane_id']")
    # Register the new tab only after its agent is live (see below). A tab that
    # is empty while registered would let the watcher close its root pane.
  else
    # Place the new pane into a 2-column x 3-row grid so agents tile instead of
    # stacking in one tall column. Read the tab geometry and pick which pane to
    # split and how, from the count of panes already there.
    probe="$(herdr pane list | python3 -c "import sys,json;t='$into_tab';print(next((p['pane_id'] for p in json.load(sys.stdin)['result']['panes'] if p.get('tab_id')==t), ''))")"
    [ -n "$probe" ] || { echo "target tab has no panes: $into_tab" >&2; exit 2; }
    layout_json="$(herdr pane layout --pane "$probe")" || exit 4
    sel="$(GRID_COUNT="$count" LAYOUT="$layout_json" python3 - <<'PY'
import os, json
count = int(os.environ["GRID_COUNT"])
layout = json.loads(os.environ["LAYOUT"])["result"]["layout"]
panes = layout["panes"]
H = layout["area"]["height"]
def rect(p): return p["rect"]
def near(a, b, tol=2): return abs(a - b) <= tol
xs = sorted(set(rect(p)["x"] for p in panes))
left_x, right_x = xs[0], xs[-1]
if count <= 1:                       # 1 -> 2: start the two columns
    t, d, ratio = panes[0], "right", "0.5"
elif count == 2:                     # 2 -> 3: first row split, left column
    t = next(p for p in panes if near(rect(p)["x"], left_x) and near(rect(p)["height"], H))
    d, ratio = "down", "0.333"
elif count == 3:                     # 3 -> 4: first row split, right column
    t = next(p for p in panes if near(rect(p)["x"], right_x) and near(rect(p)["height"], H))
    d, ratio = "down", "0.333"
elif count == 4:                     # 4 -> 5: second row split, left column
    t = max((p for p in panes if near(rect(p)["x"], left_x)), key=lambda p: rect(p)["height"])
    d, ratio = "down", "0.5"
else:                                # 5 -> 6: second row split, right column
    t = max((p for p in panes if near(rect(p)["x"], right_x)), key=lambda p: rect(p)["height"])
    d, ratio = "down", "0.5"
print("%s\t%s\t%s" % (t["pane_id"], d, ratio))
PY
)" || exit 4
    IFS=$'\t' read -r target_pane grid_dir grid_ratio <<<"$sel"
    [ -n "$target_pane" ] || { echo "could not pick a grid target in $into_tab" >&2; exit 4; }
    out=$(herdr pane split --pane "$target_pane" --direction "$grid_dir" --ratio "$grid_ratio" --cwd "$cwd" --no-focus) || exit 4
    pane=$(echo "$out" | json_get "d['result']['pane']['pane_id']")
  fi
fi

if [ -z "$pane" ]; then
  out=$(herdr pane split --pane "$split_pane" --direction "$split_dir" --cwd "$cwd" --no-focus) || exit 4
  pane=$(echo "$out" | json_get "d['result']['pane']['pane_id']")
fi

start() {
  herdr agent start "$name" --kind claude --pane "$pane" --timeout 90000 -- \
    --agent "team-$role" --effort "$effort" --permission-mode "$mode"
}

pending_dir="${TEAM_SCRATCH:-scratchpad}/.team/pending"
mkdir -p "$pending_dir"
pending_file="$pending_dir/$(printf '%s' "$pane" | tr ':/' '__')"
: > "$pending_file"
trap 'rm -f "$pending_file"' EXIT

out=$(start) || exit 4
if [ "$(echo "$out" | json_get "d.get('result',{}).get('status','')")" = "agent_not_ready" ]; then
  snap=$(herdr agent read "$name" --source detection --lines 20) || exit 4
  if echo "$snap" | grep -qiE 'trust|mcp server|\[y/n\]'; then
    herdr agent send-keys "$name" enter >/dev/null || exit 4
  fi
  out=$(start) || exit 4
  if [ "$(echo "$out" | json_get "d.get('result',{}).get('status','')")" = "agent_not_ready" ]; then
    echo "agent not ready after answering the startup dialog" >&2
    exit 3
  fi
fi

bar=$(herdr agent read "$name" --source detection --lines 20) || exit 4
if ! { echo "$bar" | grep -qF "$bar_model" \
    && echo "$bar" | grep -qF "$mode" \
    && echo "$bar" | grep -qF "$(basename "$cwd")"; }; then
  echo "status bar mismatch (want $bar_model/$mode/$(basename "$cwd")):" >&2
  echo "$bar" >&2
  exit 3
fi

session=$(echo "$out" | json_get "d['result']['agent']['agent_session']['value']")
session="${session:0:8}"
started=$(date -u +%Y-%m-%dT%H:%M:%SZ)

teamdir="${TEAM_SCRATCH:-scratchpad}/.team"
mkdir -p "$teamdir"

# Register a spilled tab now that its agent is live and its root pane occupied.
if [ -n "$spilled_tab" ]; then
  TAB="$spilled_tab" python3 - "$teamdir/tabs.json" <<'PY'
import os, json, sys
path = sys.argv[1]
tabs = json.load(open(path)) if os.path.exists(path) else []
t = os.environ["TAB"]
if t not in tabs: tabs.append(t)
json.dump(tabs, open(path, "w"))
PY
fi

printf '{"role":"%s","topic":"","brief":"","pane":"%s","session":"%s","started":"%s"}\n' \
  "$role" "$pane" "$session" "$started" >"$teamdir/$name.json"

printf '{"name":"%s","role":"%s","pane":"%s","session":"%s","model":"%s","mode":"%s"}\n' \
  "$name" "$role" "$pane" "$session" "$model" "$mode"
