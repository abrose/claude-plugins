#!/usr/bin/env bash
# Watch this team's agents. Push one WATCH line to the orchestrator on each
# state change, and log the same events to this pane so it shows activity.
# --spawn launches the watcher in its own small pane; --once runs a single pass
# (for tests); default loops.
set -euo pipefail

scratch="${TEAM_SCRATCH:-scratchpad}"
teamdir="$scratch/.team"
interval=5; once=""; spawn=""; own_pane_arg=""
lib="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)"
while [ $# -gt 0 ]; do
  case "$1" in
    --once) once=1; shift ;;
    --spawn) spawn=1; shift ;;
    --own-pane) own_pane_arg="${2:?}"; shift 2 ;;
    --interval) interval="${2:?}"; shift 2 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

orch() { python3 -c "import json;print(json.load(open('$teamdir/config.json')).get('orchestrator','orchestrator'))" 2>/dev/null || echo orchestrator; }

pane_id_of() { python3 -c "import sys,json;print(json.load(sys.stdin)['result']['pane']['pane_id'])"; }

log() { printf '%s %s\n' "$(date +%H:%M:%S)" "$*"; }

# Split a pane off the orchestrator pane and run the watcher there by absolute
# path, passing the new pane id as --own-pane. `herdr pane current` resolves the
# orchestrator pane (the focused one), which is a safe anchor to split from; the
# new pane's id then becomes the watcher's authoritative own-pane, so it never
# has to guess its own pane from the focused one. --ratio is the fraction the
# anchor keeps, so 0.8 leaves the orchestrator most of the tab and the watcher a
# small strip.
spawn_watcher() {
  local anchor new self self_dir
  anchor="$(herdr pane current | pane_id_of)" || { echo "cannot resolve orchestrator pane" >&2; exit 4; }
  new="$(herdr pane split --pane "$anchor" --direction down --ratio 0.8 --cwd "$PWD" --no-focus | pane_id_of)" || exit 4
  self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  self="$self_dir/$(basename "${BASH_SOURCE[0]}")"
  herdr pane run "$new" "$self" --own-pane "$new" --interval "$interval" >/dev/null || exit 4
  echo "$new"
}

pass() {
  local list orchestrator op
  mkdir -p "$teamdir"   # the state and hygiene blocks write here every pass
  # Determine our own pane. An explicit --own-pane (passed by the launcher) is
  # authoritative and wins over everything. Otherwise reuse the persisted value,
  # then fall back to `herdr pane current`. Retry the capture each pass so a
  # transient failure never leaves own_pane unset (which would let the hygiene
  # block close our own pane). While it is unknown, close nothing.
  op="${own_pane_arg:-}"
  if [ -z "${op:-}" ]; then
    op="$(python3 -c "import json,os;f='$teamdir/watch-state.json';print(json.load(open(f)).get('own_pane','') if os.path.exists(f) else '')" 2>/dev/null || true)"
  fi
  if [ -z "${op:-}" ]; then
    op="$(herdr pane current 2>/dev/null | python3 -c "import sys,json;print(json.load(sys.stdin)['result']['pane']['pane_id'])" 2>/dev/null || true)"
  fi
  list="$(herdr agent list)" || return 0
  orchestrator="$(orch)"
  # Compute the WATCH lines to send; the python prints one shell-safe line per push.
  local lines
  lines="$(PYTHONPATH="$lib" SCRATCH="$scratch" TEAMDIR="$teamdir" LIST="$list" OWN_PANE="$op" python3 - <<'PY'
import os, json
from teamlib import agent_state, role_agents
teamdir = os.environ["TEAMDIR"]
agents = json.loads(os.environ["LIST"]).get("result", {}).get("agents", [])
cur = {a["name"]: agent_state(a) for a in role_agents(agents, teamdir)}
sp = os.path.join(teamdir, "watch-state.json")
state_prev = json.load(open(sp)) if os.path.exists(sp) else {}
prev = state_prev.get("agents", {})
flag_prev = state_prev.get("_flagged", {})
own_pane = os.environ.get("OWN_PANE") or state_prev.get("own_pane")

scratch = os.environ["SCRATCH"]
def fresh_report(name):
    rec_path = os.path.join(teamdir, name + ".json")
    try:
        rec = json.load(open(rec_path))
    except Exception:
        return False
    topic = rec.get("topic", "")
    report = os.path.join(scratch, "reports", "%s-%s.md" % (name, topic))
    brief = os.path.join(scratch, "brief-%s-%s.md" % (name, topic))
    if not os.path.exists(report):
        return False
    if os.path.exists(brief) and os.path.getmtime(report) < os.path.getmtime(brief):
        return False
    return True

out = []
flagged = {}
for name, state in cur.items():
    old = prev.get(name)
    if old is not None and old != state:
        if state == "blocked":
            out.append(("blocked", name, "%s: %s -> %s" % (name, old, state)))
        else:
            out.append(("change", name, "%s: %s -> %s" % (name, old, state)))
    if state in ("idle", "done") and not fresh_report(name):
        if not flag_prev.get(name):
            out.append(("noreport", name, "%s: idle, no report" % name))
        flagged[name] = True

state_out = {"agents": cur, "_flagged": flagged}
if own_pane:
    state_out["own_pane"] = own_pane
json.dump(state_out, open(sp, "w"))
for kind, name, line in out:
    print("%s\t%s\t%s" % (kind, name, line))
PY
)" || { log "pass error: agent scan failed (continuing)"; return 0; }
  while IFS=$'\t' read -r kind name line; do
    [ -n "$line" ] || continue
    if [ "$kind" = "blocked" ]; then
      dlg="$(herdr agent read "$name" --source detection --lines 20 2>/dev/null | awk 'NF{print; exit}' || true)"
      line="$line: $dlg"
    fi
    log "$line"
    herdr agent prompt "$orchestrator" "WATCH $line" >/dev/null 2>&1 || true
  done <<<"$lines"

  # Layout hygiene: close empty panes and flag budget/idle issues in team-managed tabs.
  local panes
  panes="$(herdr pane list)" || return 0
  local hy
  hy="$(PYTHONPATH="$lib" TEAMDIR="$teamdir" PANES="$panes" OWN_PANE="$op" python3 - <<'PY'
import os, json
from teamlib import records
teamdir = os.environ["TEAMDIR"]
tabs_path = os.path.join(teamdir, "tabs.json")
team_tabs = set(json.load(open(tabs_path))) if os.path.exists(tabs_path) else set()
pending_dir = os.path.join(teamdir, "pending")
def is_pending(pane_id):
    return os.path.exists(os.path.join(pending_dir, pane_id.replace(":", "_").replace("/", "_")))
# Panes whose agent has a brief on record. An agent that never got a brief is
# NEW, not a release candidate, even when it looks idle in its freshly spawned
# pane. "consider release" fires only for a tab holding a briefed pane.
briefed_panes = {rec.get("pane") for rec in records(teamdir).values() if rec.get("brief")}
sp = os.path.join(teamdir, "watch-state.json")
own_pane = os.environ.get("OWN_PANE") or (json.load(open(sp)).get("own_pane") if os.path.exists(sp) else None)
panes = json.loads(os.environ["PANES"]).get("result", {}).get("panes", [])
occupied = {"idle", "working", "blocked", "done"}
by_tab = {}
orch_tab = None  # the orchestrator tab is the one holding own_pane
for p in panes:
    by_tab.setdefault(p.get("tab_id"), []).append(p)
    if p.get("pane_id") == own_pane:
        orch_tab = p.get("tab_id")
# Closes fire every pass; flags are debounced so an unchanged condition is
# reported once, not on every poll (layout-flags.json holds the prior flags).
lf_path = os.path.join(teamdir, "layout-flags.json")
prev_flags = set(json.load(open(lf_path))) if os.path.exists(lf_path) else set()
closes = []
flags = []
for tab, plist in by_tab.items():
    if tab not in team_tabs:
        continue
    if tab == orch_tab:
        continue  # the orchestrator tab belongs to the human: never close or flag
                  # its panes, so a pane opened there by hand survives.
    budget = 6
    if len(plist) > budget:
        flags.append("layout: tab %s over budget (%d/%d)" % (tab, len(plist), budget))
    occupied_statuses = []
    occupied_panes = []
    for p in plist:
        status = p.get("agent_status", "unknown")
        if p.get("pane_id") == own_pane:
            continue
        if status not in occupied and own_pane and not is_pending(p.get("pane_id")):
            closes.append(p.get("pane_id"))
        else:
            occupied_statuses.append(status)
            occupied_panes.append(p.get("pane_id"))
    if (tab != orch_tab and occupied_statuses
            and all(s in ("idle", "done") for s in occupied_statuses)
            and any(pp in briefed_panes for pp in occupied_panes)):
        flags.append("layout: tab %s idle, consider release" % tab)
json.dump(sorted(set(flags)), open(lf_path, "w"))
for pane_id in closes:
    print("close\t%s" % pane_id)
for f in flags:
    if f not in prev_flags:
        print("flag\t%s" % f)
PY
)" || { log "pass error: layout scan failed (continuing)"; return 0; }
  while IFS=$'\t' read -r verb rest; do
    [ -n "$verb" ] || continue
    case "$verb" in
      close) log "closed empty pane $rest"; herdr pane close "$rest" >/dev/null 2>&1 || true ;;
      flag)  log "$rest"; herdr agent prompt "$orchestrator" "WATCH $rest" >/dev/null 2>&1 || true ;;
    esac
  done <<<"$hy"
}

if [ -n "$spawn" ]; then spawn_watcher; exit 0; fi
if [ -n "$once" ]; then pass; exit 0; fi

# Loop: log events as they happen, plus a heartbeat once a minute so a quiet
# pane still shows the watcher is alive.
log "team-watch started (orchestrator=$(orch), interval=${interval}s)"
last_hb=0
while true; do
  pass || log "pass error (continuing)"
  now=$(date +%s)
  if [ $((now - last_hb)) -ge 60 ]; then log "heartbeat"; last_hb=$now; fi
  sleep "$interval"
done
