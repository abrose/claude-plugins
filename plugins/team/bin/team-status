#!/usr/bin/env bash
# Merge this team's agents from `herdr agent list` with $TEAM_SCRATCH/.team/*.json
# into a roster. The team is the role agents plus the orchestrator.
# Exit codes: 0 ok, 2 bad arguments, 4 herdr error.
set -euo pipefail

scratch="${TEAM_SCRATCH:-scratchpad}"
teamdir="$scratch/.team"

as_json=""; read_idle=""
while [ $# -gt 0 ]; do
  case "$1" in
    --json) as_json=1; shift ;;
    --read-idle) read_idle=1; shift ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

list=$(herdr agent list) || exit 4
lib="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)"

mkdir -p "$teamdir"
PYTHONPATH="$lib" SCRATCH="$scratch" TEAMDIR="$teamdir" LIST="$list" AS_JSON="$as_json" READ_IDLE="$read_idle" python3 - <<'PY'
import os, json, time, subprocess
from teamlib import agent_state, records, team_agents
scratch, teamdir = os.environ["SCRATCH"], os.environ["TEAMDIR"]
now = int(os.environ.get("TEAM_NOW", int(time.time())))
agents = json.loads(os.environ["LIST"]).get("result", {}).get("agents", [])
recs = records(teamdir)

def report_age(name, topic):
    report = os.path.join(scratch, "reports", "%s-%s.md" % (name, topic))
    brief = os.path.join(scratch, "brief-%s-%s.md" % (name, topic))
    if not os.path.exists(report):
        return "-", True
    r_mtime = os.path.getmtime(report)
    s = int(now - r_mtime)
    age = "%dm" % (s // 60) if s < 3600 else "%dh" % (s // 3600) if s < 86400 else "%dd" % (s // 86400)
    stale = os.path.exists(brief) and r_mtime < os.path.getmtime(brief)
    return age, stale

def last_screen_line(name):
    out = subprocess.run(["herdr", "agent", "read", name, "--source", "recent-unwrapped", "--lines", "8"],
                         capture_output=True, text=True).stdout
    lines = [l for l in out.splitlines() if l.strip()]
    return lines[-1] if lines else ""

out, text = [], []
for a in team_agents(agents, teamdir):
    name = a["name"]
    state = agent_state(a)
    rec = recs.get(name, {})
    role, topic = rec.get("role", ""), rec.get("topic", "")
    age, stale = report_age(name, topic)
    rec_out = {"name": name, "pane": a.get("pane_id", ""),
               "session": a.get("agent_session", {}).get("value", "")[:8],
               "state": state, "role": role, "topic": topic, "report_age": age}
    out.append(rec_out)
    row = "%s (%s, %s) %s %s %s %s" % (name, rec_out["pane"], rec_out["session"], state,
                                       role or "-", topic or "-", age)
    if os.environ.get("READ_IDLE") and state in ("idle", "done") and stale:
        note = last_screen_line(name)
        if note:
            row += "  | " + note
    text.append(row)

with open(os.path.join(teamdir, "roster.md"), "w") as fh:
    fh.write("\n".join(text) + ("\n" if text else ""))
if os.environ.get("AS_JSON"):
    print(json.dumps(out))
else:
    print("\n".join(text))
PY
