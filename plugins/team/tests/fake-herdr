#!/usr/bin/env bash
# Test double for the herdr CLI. Records every invocation to $FAKE_HERDR_LOG
# (one space-joined line per call) and answers with canned JSON selected by
# $FAKE_HERDR_SCENARIO. It is a real executable on PATH, not a mock: the script
# under test cannot tell it apart from herdr.
set -euo pipefail

log="${FAKE_HERDR_LOG:?FAKE_HERDR_LOG unset}"
scenario="${FAKE_HERDR_SCENARIO:-ok}"

# Count prior invocations of a "<group> <sub>" pair before recording this one,
# so a response can vary across repeated calls (e.g. dialog then status bar).
prior() { grep -c -E -- "^$1 $2( |\$)" "$log" 2>/dev/null || true; }

group="${1:-}"
sub="${2:-}"
same_before="$(prior "$group" "$sub")"

printf '%s\n' "$*" >>"$log"

emit() { printf '%s\n' "$1"; }
fail() { printf '%s\n' "$1" >&2; exit 1; }

case "$group $sub" in
  "pane split")
    emit '{"result":{"pane":{"pane_id":"w1:p9"}}}' ;;
  "pane current")
    if [ "$scenario" = "own_pane_blind" ]; then
      emit '{"result":{"pane":{}}}'
    else
      emit '{"result":{"pane":{"pane_id":"w1:p1","workspace_id":"w1","tab_id":"w1:t1"}}}'
    fi ;;
  "pane run")
    emit '{"result":{"ok":true}}' ;;
  "pane layout")
    case "$scenario" in
      grid1)
        emit '{"result":{"layout":{"area":{"x":0,"y":0,"width":200,"height":60},"panes":[
          {"pane_id":"w1:g1","rect":{"x":0,"y":0,"width":200,"height":60}}
        ]}}}' ;;
      grid2)
        emit '{"result":{"layout":{"area":{"x":0,"y":0,"width":200,"height":60},"panes":[
          {"pane_id":"w1:g1","rect":{"x":0,"y":0,"width":100,"height":60}},
          {"pane_id":"w1:g2","rect":{"x":100,"y":0,"width":100,"height":60}}
        ]}}}' ;;
      grid3)
        emit '{"result":{"layout":{"area":{"x":0,"y":0,"width":200,"height":60},"panes":[
          {"pane_id":"w1:g1","rect":{"x":0,"y":0,"width":100,"height":20}},
          {"pane_id":"w1:g3","rect":{"x":0,"y":20,"width":100,"height":40}},
          {"pane_id":"w1:g2","rect":{"x":100,"y":0,"width":100,"height":60}}
        ]}}}' ;;
      grid4)
        emit '{"result":{"layout":{"area":{"x":0,"y":0,"width":200,"height":60},"panes":[
          {"pane_id":"w1:g1","rect":{"x":0,"y":0,"width":100,"height":20}},
          {"pane_id":"w1:g3","rect":{"x":0,"y":20,"width":100,"height":40}},
          {"pane_id":"w1:g2","rect":{"x":100,"y":0,"width":100,"height":20}},
          {"pane_id":"w1:g4","rect":{"x":100,"y":20,"width":100,"height":40}}
        ]}}}' ;;
      grid5)
        emit '{"result":{"layout":{"area":{"x":0,"y":0,"width":200,"height":60},"panes":[
          {"pane_id":"w1:g1","rect":{"x":0,"y":0,"width":100,"height":20}},
          {"pane_id":"w1:g3","rect":{"x":0,"y":20,"width":100,"height":20}},
          {"pane_id":"w1:g5","rect":{"x":0,"y":40,"width":100,"height":20}},
          {"pane_id":"w1:g2","rect":{"x":100,"y":0,"width":100,"height":20}},
          {"pane_id":"w1:g4","rect":{"x":100,"y":20,"width":100,"height":40}}
        ]}}}' ;;
      *)
        emit '{"result":{"layout":{"area":{"x":0,"y":0,"width":200,"height":50},"panes":[]}}}' ;;
    esac ;;
  "pane close")
    emit '{"result":{"ok":true}}' ;;
  "tab create")
    emit '{"result":{"tab":{"tab_id":"w1:t9"},"root_pane":{"pane_id":"w1:p9"}}}' ;;
  "agent start")
    if [ "$scenario" = "first_run_dialog" ] && [ "$same_before" -eq 0 ]; then
      fail '{"error":{"code":"agent_not_ready","message":"agent is blocked during startup and is not ready for prompts"}}'
    elif [ "$scenario" = "start_fails" ]; then
      fail '{"error":{"code":"agent_pane_not_found","message":"agent target pane w1:p2 not found"}}'
    else
      emit '{"result":{"agent":{"name":"a","pane_id":"w1:p9","agent_status":"idle","agent_session":{"value":"abcdef1234567890"}}}}'
    fi ;;
  "agent read")
    if [ "$scenario" = "first_run_dialog" ] && [ "$same_before" -eq 0 ]; then
      emit 'Quick safety check: Is this a project you created or one you trust?
 ❯ No, exit
   Yes, I trust this folder'
    elif [ "$scenario" = "prompt_blocked_midrun" ]; then
      emit 'Allow Bash(rm -rf build)? [y/n]'
    else
      emit "${FAKE_STATUS_MODEL:-Opus 4.8} | ${FAKE_STATUS_MODE:-auto} | ${FAKE_STATUS_CWD:-/tmp}"
    fi ;;
  "agent get")
    emit '{"result":{"agent":{"agent_status":"idle"}}}' ;;
  "pane get")
    emit "{\"result\":{\"pane\":{\"pane_id\":\"w1:p1\",\"tab_id\":\"w1:t1\",\"cwd\":\"${FAKE_PANE_CWD:-/tmp}\"}}}" ;;
  "agent send-keys")
    emit '{"result":{"ok":true}}' ;;
  "agent wait")
    emit '{"result":{"agent":{"agent_status":"idle"}}}' ;;
  "agent prompt")
    case "$scenario" in
      prompt_stalled) fail '{"error":{"code":"agent_prompt_stalled"}}' ;;
      prompt_blocked) fail '{"error":{"code":"agent_blocked","dialog":"Allow write? [y/n]"}}' ;;
      prompt_no_status) emit '{"result":{"type":"agent_info"}}' ;;
      prompt_working) emit '{"result":{"agent":{"agent_status":"working"}}}' ;;
      prompt_blocked_midrun) emit '{"result":{"agent":{"agent_status":"blocked"}}}' ;;
      *) emit '{"result":{"agent":{"agent_status":"idle"}}}' ;;
    esac ;;
  "agent list")
    case "$scenario" in
      watch_change)
        if [ "$same_before" -eq 0 ]; then
          emit '{"result":{"agents":[{"name":"app-1-scout","pane_id":"w1:p2","agent_status":"working","agent_session":{"value":"aaaa1111"}}]}}'
        else
          emit '{"result":{"agents":[{"name":"app-1-scout","pane_id":"w1:p2","agent_status":"blocked","agent_session":{"value":"aaaa1111"}}]}}'
        fi ;;
      watch_two_teams)
        emit '{"result":{"agents":[
          {"name":"app-1-scout","pane_id":"w1:p2","agent_status":"blocked","agent_session":{"value":"aaaa1111"}},
          {"name":"app-2-maker","pane_id":"w2:p2","agent_status":"working","agent_session":{"value":"bbbb2222"}}
        ]}}' ;;
      watch_idle)
        emit '{"result":{"agents":[{"name":"app-1-scout","pane_id":"w1:p2","agent_status":"idle","agent_session":{"value":"aaaa1111"}}]}}' ;;
      bad_list)
        emit 'not json' ;;
      status_mixed)
        emit '{"result":{"agents":[
          {"name":"scout","pane_id":"w1:p2","agent_status":"idle","agent_session":{"value":"11111111aaaa"}},
          {"name":"maker","pane_id":"w1:p3","agent_status":"working","agent_session":{"value":"22222222bbbb"}}
        ]}}' ;;
      status_two_teams)
        emit '{"result":{"agents":[
          {"name":"bug-3-orch","pane_id":"w1:p7","agent_status":"done","agent_session":{"value":"99999999cccc"}},
          {"name":"app-1-orch","pane_id":"w2:p1","agent_status":"working","agent_session":{"value":"oooo0000dddd"}},
          {"name":"app-1-scout","pane_id":"w2:p2","agent_status":"idle","agent_session":{"value":"11111111aaaa"}},
          {"pane_id":"w2:pB","agent_status":"idle","agent_session":{"value":"c23a1be5eeee"}}
        ]}}' ;;
      names_app1_taken)
        emit '{"result":{"agents":[
          {"name":"app-1-orch","pane_id":"w1:p1","agent_status":"idle","agent_session":{"value":"oooo0000"}},
          {"name":"app-1-scout","pane_id":"w1:p2","agent_status":"working","agent_session":{"value":"ssss1111"}}
        ]}}' ;;
      name_scout_taken)
        emit '{"result":{"agents":[{"name":"app-1-scout","pane_id":"w1:p2","agent_status":"working","agent_session":{"value":"ssss1111"}}]}}' ;;
      *)
        emit '{"result":{"agents":[]}}' ;;
    esac ;;
  "pane list")
    case "$scenario" in
      panes_empty | own_pane_blind)
        emit '{"result":{"panes":[
          {"pane_id":"w1:p2","tab_id":"w1:t2","agent_status":"idle"},
          {"pane_id":"w1:p3","tab_id":"w1:t2","agent_status":"unknown"}
        ]}}' ;;
      panes_idle_only)
        emit '{"result":{"panes":[
          {"pane_id":"w1:p2","tab_id":"w1:t2","agent_status":"idle"},
          {"pane_id":"w1:p3","tab_id":"w1:t2","agent_status":"idle"}
        ]}}' ;;
      panes_overbudget)
        emit '{"result":{"panes":[
          {"pane_id":"w1:p2","tab_id":"w1:t2","agent_status":"working"},
          {"pane_id":"w1:p3","tab_id":"w1:t2","agent_status":"working"},
          {"pane_id":"w1:p4","tab_id":"w1:t2","agent_status":"working"},
          {"pane_id":"w1:p5","tab_id":"w1:t2","agent_status":"working"},
          {"pane_id":"w1:p6","tab_id":"w1:t2","agent_status":"working"},
          {"pane_id":"w1:p7","tab_id":"w1:t2","agent_status":"working"},
          {"pane_id":"w1:p8","tab_id":"w1:t2","agent_status":"working"}
        ]}}' ;;
      grid1)
        emit '{"result":{"panes":[{"pane_id":"w1:g1","tab_id":"w1:tG","agent_status":"working"}]}}' ;;
      fresh_tab)
        emit '{"result":{"panes":[{"pane_id":"w1:g1","tab_id":"w1:tG","agent_status":"unknown"}]}}' ;;
      grid2)
        emit '{"result":{"panes":[
          {"pane_id":"w1:g1","tab_id":"w1:tG","agent_status":"working"},
          {"pane_id":"w1:g2","tab_id":"w1:tG","agent_status":"working"}
        ]}}' ;;
      grid3)
        emit '{"result":{"panes":[
          {"pane_id":"w1:g1","tab_id":"w1:tG","agent_status":"working"},
          {"pane_id":"w1:g3","tab_id":"w1:tG","agent_status":"working"},
          {"pane_id":"w1:g2","tab_id":"w1:tG","agent_status":"working"}
        ]}}' ;;
      grid4)
        emit '{"result":{"panes":[
          {"pane_id":"w1:g1","tab_id":"w1:tG","agent_status":"working"},
          {"pane_id":"w1:g3","tab_id":"w1:tG","agent_status":"working"},
          {"pane_id":"w1:g2","tab_id":"w1:tG","agent_status":"working"},
          {"pane_id":"w1:g4","tab_id":"w1:tG","agent_status":"working"}
        ]}}' ;;
      grid5)
        emit '{"result":{"panes":[
          {"pane_id":"w1:g1","tab_id":"w1:tG","agent_status":"working"},
          {"pane_id":"w1:g3","tab_id":"w1:tG","agent_status":"working"},
          {"pane_id":"w1:g5","tab_id":"w1:tG","agent_status":"working"},
          {"pane_id":"w1:g2","tab_id":"w1:tG","agent_status":"working"},
          {"pane_id":"w1:g4","tab_id":"w1:tG","agent_status":"working"}
        ]}}' ;;
      *)
        emit '{"result":{"panes":[]}}' ;;
    esac ;;
  *)
    emit '{"result":{"ok":true}}' ;;
esac
