#!/usr/bin/env bash
# Test double for the herdr CLI. Records every invocation to $FAKE_HERDR_LOG
# (one space-joined line per call) and answers with canned JSON selected by
# $FAKE_HERDR_SCENARIO. It is a real executable on PATH, not a mock: the script
# under test cannot tell it apart from herdr.
set -euo pipefail

log="${FAKE_HERDR_LOG:?FAKE_HERDR_LOG unset}"
scenario="${FAKE_HERDR_SCENARIO:-ok}"

# Count prior invocations of a "<group> <sub>" pair before recording this one,
# so a response can vary across repeated calls (e.g. dialog then status bar).
prior() { grep -c -E -- "^$1 $2( |\$)" "$log" 2>/dev/null || true; }

group="${1:-}"
sub="${2:-}"
same_before="$(prior "$group" "$sub")"

printf '%s\n' "$*" >>"$log"

emit() { printf '%s\n' "$1"; }
fail() { printf '%s\n' "$1" >&2; exit 1; }

case "$group $sub" in
  "pane split")
    emit '{"result":{"pane":{"pane_id":"w1:p9"}}}' ;;
  "pane current")
    if [ "$scenario" = "own_pane_blind" ]; then
      emit '{"result":{"pane":{}}}'
    else
      emit '{"result":{"pane":{"pane_id":"w1:p1"}}}'
    fi ;;
  "pane run")
    emit '{"result":{"ok":true}}' ;;
  "pane layout")
    emit '{"result":{"layout":{"width":200,"height":50}}}' ;;
  "pane close")
    emit '{"result":{"ok":true}}' ;;
  "tab create")
    emit '{"result":{"tab":{"tab_id":"w1:t9"},"root_pane":{"pane_id":"w1:p9"}}}' ;;
  "agent start")
    if [ "$scenario" = "first_run_dialog" ] && [ "$same_before" -eq 0 ]; then
      emit '{"result":{"status":"agent_not_ready"}}'
    else
      emit '{"result":{"agent":{"name":"a","pane_id":"w1:p9","state":"idle","agent_session":{"value":"abcdef1234567890"}}}}'
    fi ;;
  "agent read")
    if [ "$scenario" = "first_run_dialog" ] && [ "$same_before" -eq 0 ]; then
      emit 'Do you trust the files in this workspace? An MCP server wants to start. [y/n]'
    else
      emit "${FAKE_STATUS_MODEL:-Opus 4.8} | ${FAKE_STATUS_MODE:-auto} | ${FAKE_STATUS_CWD:-/tmp}"
    fi ;;
  "agent get")
    emit '{"result":{"agent":{"state":"idle"}}}' ;;
  "pane get")
    emit '{"result":{"pane":{"pane_id":"w1:p1","tab_id":"w1:t1"}}}' ;;
  "agent send-keys")
    emit '{"result":{"ok":true}}' ;;
  "agent wait")
    emit '{"result":{"state":"idle"}}' ;;
  "agent prompt")
    case "$scenario" in
      prompt_stalled) fail '{"error":{"code":"agent_prompt_stalled"}}' ;;
      prompt_blocked) fail '{"error":{"code":"agent_blocked","dialog":"Allow write? [y/n]"}}' ;;
      *) emit '{"result":{"state":"working"}}' ;;
    esac ;;
  "agent list")
    case "$scenario" in
      watch_change)
        if [ "$same_before" -eq 0 ]; then
          emit '{"result":{"agents":[{"name":"app-1-scout","pane_id":"w1:p2","state":"working","agent_session":{"value":"aaaa1111"}}]}}'
        else
          emit '{"result":{"agents":[{"name":"app-1-scout","pane_id":"w1:p2","state":"blocked","agent_session":{"value":"aaaa1111"}}]}}'
        fi ;;
      watch_two_teams)
        emit '{"result":{"agents":[
          {"name":"app-1-scout","pane_id":"w1:p2","state":"blocked","agent_session":{"value":"aaaa1111"}},
          {"name":"app-2-maker","pane_id":"w2:p2","state":"working","agent_session":{"value":"bbbb2222"}}
        ]}}' ;;
      watch_idle)
        emit '{"result":{"agents":[{"name":"app-1-scout","pane_id":"w1:p2","state":"idle","agent_session":{"value":"aaaa1111"}}]}}' ;;
      bad_list)
        emit 'not json' ;;
      status_mixed)
        emit '{"result":{"agents":[
          {"name":"scout","pane_id":"w1:p2","state":"idle","agent_session":{"value":"11111111aaaa"}},
          {"name":"maker","pane_id":"w1:p3","state":"working","agent_session":{"value":"22222222bbbb"}}
        ]}}' ;;
      *)
        emit '{"result":{"agents":[{"name":"scout","pane_id":"w1:p2","state":"idle","agent_session":{"value":"11111111aaaa"}}]}}' ;;
    esac ;;
  "pane list")
    case "$scenario" in
      panes_empty | own_pane_blind)
        emit '{"result":{"panes":[
          {"pane_id":"w1:p2","tab_id":"w1:t2","agent_status":"idle"},
          {"pane_id":"w1:p3","tab_id":"w1:t2","agent_status":"unknown"}
        ]}}' ;;
      panes_idle_only)
        emit '{"result":{"panes":[
          {"pane_id":"w1:p2","tab_id":"w1:t2","agent_status":"idle"},
          {"pane_id":"w1:p3","tab_id":"w1:t2","agent_status":"idle"}
        ]}}' ;;
      panes_overbudget)
        emit '{"result":{"panes":[
          {"pane_id":"w1:p2","tab_id":"w1:t2","agent_status":"working"},
          {"pane_id":"w1:p3","tab_id":"w1:t2","agent_status":"working"},
          {"pane_id":"w1:p4","tab_id":"w1:t2","agent_status":"working"},
          {"pane_id":"w1:p5","tab_id":"w1:t2","agent_status":"working"},
          {"pane_id":"w1:p6","tab_id":"w1:t2","agent_status":"working"},
          {"pane_id":"w1:p7","tab_id":"w1:t2","agent_status":"working"},
          {"pane_id":"w1:p8","tab_id":"w1:t2","agent_status":"working"}
        ]}}' ;;
      *)
        emit '{"result":{"panes":[]}}' ;;
    esac ;;
  *)
    emit '{"result":{"ok":true}}' ;;
esac
