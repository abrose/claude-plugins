# Local reference material only - not distributed.
# Contains the copyrighted ASD-STE100 standard PDF used while authoring the
# simplified-technical-english plugins. The rules are distilled into each
# plugin's instructions/ and output-styles/ files; the PDF is not needed at runtime.
plugins/simplified-technical-english/docs/

# Generated by Claude Code when it loads a plugin's mod; extends the
# engine-written .claude-plugin/types/tsconfig.json, which is ignored too.
plugins/*/tsconfig.json

# Python bytecode cache from running the quota-statusline tests.
__pycache__/
*.pyc

# Team worktrees made by team-slice (see .claude/team/project.yaml).
.worktrees/
